# Copy to .env and fill in your values
# Do not commit .env to git.

# Your API key (OpenRouter, Anthropic, or OpenAI)
ARQUS_API_KEY=

# Default model (format: provider:model)
ARQUS_MODEL=openrouter:deepseek/deepseek-chat

# Provider endpoint
ARQUS_BASE_URL=https://openrouter.ai/api/v1
ARQUS_PROVIDER=openrouter

# Enable debug logging to <ARQUS_HOME>/debug.log (1 or true)
# ARQUS_DEBUG=1

# Maximum tokens generated per response
# ARQUS_MAX_OUTPUT_TOKENS=300

# Optional: isolate development sessions to a temporary directory
# ARQUS_HOME=/tmp/arqus-dev

